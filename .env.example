# Authenticated deployment template. Replace every REPLACE value and provide
# the mounted directories before starting. This file is not loaded by the
# binary automatically, and the tutorial Compose file does not forward it.
# See docs/configuration.md. For the runnable demo, follow README.md instead.
GATEWAY_LISTEN_ADDR=127.0.0.1:8080
GATEWAY_PUBLIC_URL=https://gateway.example.com
GATEWAY_LOG_LEVEL=info
GATEWAY_AUTH_MODE=enforce
GATEWAY_DEPLOYMENT_PROFILE=prod
GATEWAY_SERVERS_DIR=/etc/mcp-gateway/servers
GATEWAY_POLICIES_DIR=/etc/mcp-gateway/policies

# Sensitive: inject the real URL through your deployment's secret provider.
GATEWAY_DATABASE_URL=postgres://gateway:REPLACE_DATABASE_PASSWORD@postgres:5432/gateway

AUTHENTIK_ISSUER=https://idp.example.com/application/o/mcp-gateway/
# Dashboard login: all three are required together. Register callback
# https://gateway.example.com/admin/auth/callback with your identity provider.
GATEWAY_DASHBOARD_CLIENT_ID=REPLACE_DASHBOARD_CLIENT_ID
GATEWAY_DASHBOARD_CLIENT_SECRET=REPLACE_DASHBOARD_CLIENT_SECRET
GATEWAY_DASHBOARD_SESSION_KEY=REPLACE_BASE64_32_RANDOM_BYTES

# Built-in authorization server: a separate OAuth client with callback
# https://gateway.example.com/oauth/callback. This also requires the database,
# identity signing key, and issuer above. Keep the two encryption keys distinct.
GATEWAY_AS_ENABLED=true
GATEWAY_AS_UPSTREAM_CLIENT_ID=REPLACE_AS_CLIENT_ID
GATEWAY_AS_UPSTREAM_CLIENT_SECRET=REPLACE_AS_CLIENT_SECRET
GATEWAY_UPSTREAM_TOKEN_KEY_V1=REPLACE_BASE64_32_RANDOM_BYTES
# Secret file: Ed25519 PKCS8 PEM. Mount it read-only; do not commit its content.
GATEWAY_IDENTITY_SIGNING_KEY_PATH=/run/secrets/gateway-identity.pem
GATEWAY_IDENTITY_KID=gateway-v1

# Optional subsystems: leave unused settings absent, not empty.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=mcp-gateway
# GATEWAY_FILE_STORAGE_DIR=/var/lib/mcp-gateway/files
# GATEWAY_CODEMODE_RESULT_STORAGE=allow
# GATEWAY_CODEMODE_EXECUTION_LIMIT_SECONDS=5

# Provider credentials, skill-source tokens, and optional integration settings
# belong in deployment-owned configuration. See the subsystem guides linked
# from docs/configuration.md before enabling their network access.
