      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, server) (rate(mcp_upstream_latency_seconds_bucket[5m])))",
          "legendFormat": "p50 {{server}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, server) (rate(mcp_upstream_latency_seconds_bucket[5m])))",
          "legendFormat": "p95 {{server}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, server) (rate(mcp_upstream_latency_seconds_bucket[5m])))",
          "legendFormat": "p99 {{server}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 9,
      "title": "Authz latency heatmap",
      "type": "heatmap",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (le) (rate(mcp_authz_latency_seconds_bucket[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Identity-cell wait p99 by server",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, server) (rate(mcp_identity_cell_wait_seconds_bucket[5m])))",
          "legendFormat": "p99 {{server}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Identity-cell queue depth by server",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "max by (server) (mcp_identity_cell_queue_depth)",
          "legendFormat": "{{server}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Server operation p50 / p95 / p99 by method \u00d7 outcome",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le, method, outcome) (rate(mcp_server_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p50 {{method}} {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le, method, outcome) (rate(mcp_server_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{method}} {{outcome}}",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le, method, outcome) (rate(mcp_server_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{method}} {{outcome}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 13,
      "title": "LLM cost USD (last 1h)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 44
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Scoped to currency=USD so the single value and the currencyUSD unit stay honest. A multi-currency total would need a per-currency panel (deferred until a non-USD catalog model exists).",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "expr": "sum(increase(gen_ai_client_cost_total{currency=\"USD\"}[1h]))",
          "legendFormat": "cost",
          "refId": "A"
        }
      ]
    },
    {
