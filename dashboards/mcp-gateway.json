    {
      "id": 17,
      "title": "LLM token rate by provider \u00d7 model \u00d7 type",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        }
      },
      "targets": [
        {
          "expr": "sum by (provider, model, type) (rate(gen_ai_client_token_usage_total[5m]))",
          "legendFormat": "{{provider}}/{{model}} {{type}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 18,
      "title": "LLM cost rate by provider \u00d7 model \u00d7 currency ($/hr)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 48
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Grouped by currency so per-currency series never sum together (the cost metric is labeled by the catalog currency, which defaults to USD but may differ per model). The currencyUSD unit renders the dominant USD case; non-USD lines carry the same glyph but are never aggregated with USD.",
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "targets": [
        {
          "expr": "sum by (provider, model, currency) (rate(gen_ai_client_cost_total[5m])) * 3600",
          "legendFormat": "{{provider}}/{{model}} {{currency}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 19,
      "title": "LLM calls by model \u00d7 finish reason",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 56
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum by (model, finish_reason) (rate(gen_ai_client_calls_total[5m]))",
          "legendFormat": "{{model}} / {{finish_reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "title": "Invocation schema-validator cache events",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Stage 6 validator-cache activity. Sustained misses or evictions indicate schema churn; compile failures refuse dispatch.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum by (__name__) (rate({__name__=~\"mcp_schema_validator_cache_(hits|misses|evictions)_total|mcp_schema_validator_compile_failures_total\"}[5m]))",
          "legendFormat": "{{__name__}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "title": "Invocation fallback and authority refusals",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 64
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Manifest admissions by approval-authority posture and fail-closed refusals when approval requirements are unknown.",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "targets": [
        {
          "expr": "sum by (approval_authority) (rate(mcp_invocation_manifest_fallback_total[5m]))",
          "legendFormat": "fallback {{approval_authority}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(mcp_invocation_approval_unknown_refusals_total[5m]))",
          "legendFormat": "approval authority refused",
          "refId": "B"
        }
      ]
    },
    {
      "id": 22,
      "title": "Chained best-effort evidence writes",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 72
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Attempted, inserted, dropped, and unknown hash-chained best-effort evidence writes. Unknown means commit started but the caller did not observe whether PostgreSQL committed. Attempted minus terminal outcomes can include writes still in flight or tasks cancelled during the write.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(mcp_evidence_chained_best_effort_total[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "title": "Chained evidence failures by stage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 80
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Confirmed failures split by the bounded database-write stage. A tx_commit failure is unknown; failures before commit are confirmed drops.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        }
      },
      "targets": [
        {
          "expr": "sum by (stage) (rate(mcp_evidence_chained_best_effort_failures_total[5m]))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 24,
      "title": "Chained evidence write p95",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 80
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "95th-percentile end-to-end write latency by terminal outcome. Sustained movement toward the one-second deadline indicates database or pool pressure.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(mcp_evidence_chained_best_effort_duration_seconds_bucket[5m])))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 25,
      "title": "Pending bounded evidence",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 88
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Events accepted into the bounded recorder but not yet completed by its backing sink. Channel buffers hold 1,024 chained events across four tenant shards and 256 informational events; workers can additionally hold one 32-event batch per channel, for maxima of 1,152 and 288 outstanding events.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum by (posture) (mcp_evidence_submission_pending)",
          "legendFormat": "{{posture}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 26,
      "title": "Evidence admission loss",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 88
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Queue-full, queue-closed, shutdown-deadline, and recovered worker-panic drops by posture, plus oversized free-form reasons truncated before admission.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        }
      },
      "targets": [
        {
          "expr": "sum by (posture, outcome) (rate(mcp_evidence_submission_total{outcome=~\"dropped_.*\"}[5m]))",
          "legendFormat": "{{posture}} {{outcome}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(mcp_evidence_reason_truncations_total[5m]))",
          "legendFormat": "reason truncated",
          "refId": "B"
        }
      ]
    },
    {
      "id": 27,
      "title": "Database pool connections by workload",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 96
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Live in-use, idle, and configured maximum connections for the isolated audit, control-plane, and reader pools. A missing reader series means reads fell back to the control pool at boot; audit remains isolated.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
